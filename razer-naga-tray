#!/usr/bin/env python3
"""Tray icon for a Razer Naga V2 Pro: battery level, charging state, low-battery notifications."""
import json
import os
import queue
import select
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from PyQt6.QtCore import QObject, QRectF, Qt, QTimer, pyqtSignal  # noqa: E402
from PyQt6.QtGui import QAction, QActionGroup, QColor, QFont, QIcon, QPainter, QPainterPath, QPalette, QPen, QPixmap  # noqa: E402
from PyQt6.QtWidgets import QApplication, QColorDialog, QMenu, QSystemTrayIcon  # noqa: E402

from battery_stats import Session  # noqa: E402
from razer_naga import (DOCK_EVENTS, EVENT_INTERFACE, EVENT_REPORT_ID, MouseAsleep, NagaV2Pro,  # noqa: E402
                        NoPermission, NoReceiver, RazerError, dock_set_colour, dock_set_frame,
                        find_links, pct)

POLL_SECONDS = 60
CHARGING_POLL_SECONDS = 10  # the gauge ticks ~once a minute on charge; time the ticks closely
WARN_AT = (20, 10, 5)
IDLE_CHOICES = (60, 120, 300, 600, 900)
APP_NAME = "Razer mouse"
SHORT_LINK = {"USB cable": "USB", "Mouse Dock Pro": "dock", "wireless dongle": "dongle"}
HISTORY = os.path.expanduser("~/.local/state/razer-naga-tray/battery.csv")
SETTINGS = os.path.expanduser("~/.config/razer-naga-tray/settings.json")
RING_BRIGHTNESS = {"Low": 64, "Medium": 128, "High": 204}
RING_EVERY = {True: 60, False: 10 * 60}
RING_CHARGED_AT, RING_CHARGED = 95, (0, 0, 255)  # on a charger and near full: blue, whatever the source  # seconds between colour updates, by charging state
# Tuned by eye on the dock: its LEDs run green-heavy, so warm shades need far less green than on screen.
RING_STOPS = ((0, (255, 0, 0)), (15, (255, 30, 0)), (40, (255, 90, 0)), (70, (160, 200, 0)), (100, (0, 255, 0)))


def led_colour(rgb):
    """Screen colours are gamma-encoded and the dock's LEDs are linear, so decode before sending."""
    return tuple(round(255 * (c / 255) ** 2.2) for c in rgb)


def swatch(rgb):
    pix = QPixmap(16, 16)
    pix.fill(QColor(*rgb))
    return QIcon(pix)


def ring_colour(level):
    for (lo, a), (hi, b) in zip(RING_STOPS, RING_STOPS[1:]):
        if level <= hi:
            f = (level - lo) / (hi - lo)
            return tuple(round(x + (y - x) * f) for x, y in zip(a, b))
    return RING_STOPS[-1][1]


def load_settings():
    try:
        with open(SETTINGS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_settings(settings):
    try:
        os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
        with open(SETTINGS, "w") as f:
            json.dump(settings, f)
    except OSError:
        pass


def notify(title, body, urgency="normal", replaces=None):
    """Returns the notification id, so it can be replaced or closed later."""
    cmd = ["notify-send", "-p", "-a", APP_NAME, "-i", "input-mouse", "-u", urgency, title, body]
    if replaces:
        cmd[2:2] = ["-r", str(replaces)]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
        return int(out) if out.isdigit() else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def close_notification(notification_id):
    subprocess.Popen(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                      "--object-path", "/org/freedesktop/Notifications",
                      "--method", "org.freedesktop.Notifications.CloseNotification", str(notification_id)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def level_colour(level):
    if level is None:
        return QColor("#8a8a8a")
    if level <= 10:
        return QColor("#e5484d")
    if level <= 20:
        return QColor("#f5a524")
    return QColor("#46a758")


CHARGING = QColor("#46a758")
FULL = QColor("#3b82f6")
LOW = QColor("#e5484d")
LOW_AT = 20
EMPTY = QColor(0, 0, 0, 70)
GREY = QColor("#8a8a8a")


def panel_colour():
    """The theme's text colour, so the on-battery icon is white on a dark panel and dark on a light one."""
    return QApplication.palette().color(QPalette.ColorRole.WindowText)


def render_icon(level, charging, stale, plain=None):
    """A battery: fill grows from the left while charging, and drains toward the right on battery."""
    plain = plain or panel_colour()
    full = charging and level is not None and level >= 100
    outline = GREY if stale else FULL if full else CHARGING if charging else plain
    size, stroke, radius = 64, 5, 13
    pix = QPixmap(size, size)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    body = QRectF(stroke / 2 + 1, stroke / 2 + 1, size - stroke - 2, size - stroke - 2)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(EMPTY)
    p.drawRoundedRect(body, radius, radius)

    fill_rect, fill = None, None
    if level is not None:
        inner = body.adjusted(stroke / 2, stroke / 2, -stroke / 2, -stroke / 2)
        width = inner.width() * max(0, min(100, level)) / 100
        x = inner.left() if charging else inner.right() - width
        clip = QPainterPath()
        clip.addRoundedRect(inner, radius - stroke / 2, radius - stroke / 2)
        p.setClipPath(clip)
        fill = GREY if stale else FULL if full else LOW if level <= LOW_AT else CHARGING if charging else plain
        fill_rect = QRectF(x, inner.top(), width, inner.height())
        p.setBrush(fill)
        p.drawRect(fill_rect)
        p.setClipping(False)

    p.setPen(QPen(outline, stroke))
    p.setBrush(Qt.BrushStyle.NoBrush)
    p.drawRoundedRect(body, radius, radius)

    text = "?" if level is None else str(level)
    # Medium, not Black: at tray size a heavy weight fills in the holes of 8, 0 and 6.
    font = QFont("Sans", 31 if len(text) < 3 else 21, QFont.Weight.Medium)
    path = QPainterPath()
    path.addText(0, 0, font, text)
    box = path.boundingRect()
    path.translate((size - box.width()) / 2 - box.left(), (size - box.height()) / 2 - box.top())
    p.setPen(QPen(QColor(0, 0, 0, 170), 2))
    p.setBrush(Qt.BrushStyle.NoBrush)
    p.drawPath(path)  # dark edge first, so the white reads over both fill and empty
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("white"))
    p.drawPath(path)
    if fill is plain and plain.lightness() > 128:
        # White on a white fill vanishes, so the part of the number over the fill is inverted.
        p.setClipRect(fill_rect)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor("#1b1e20"))
        p.drawPath(path)
    p.end()
    return QIcon(pix)


class Reader(QObject):
    """Runs mouse jobs in order on one worker thread; a sleeping mouse takes most of a second to time out."""

    finished = pyqtSignal(dict)

    def __init__(self):
        super().__init__()
        self.mouse = NagaV2Pro()
        self.jobs = queue.Queue()
        self.poll_queued = threading.Event()
        threading.Thread(target=self._work, daemon=True).start()

    def poll(self):
        # A sleeping mouse must not pile up a backlog of polls.
        if not self.poll_queued.is_set():
            self.poll_queued.set()
            self.jobs.put(None)

    def run(self, job):
        self.jobs.put(job)

    def _work(self):
        while True:
            job = self.jobs.get()
            if job is None:
                self.poll_queued.clear()
                job = read_status
            self.finished.emit(self._attempt(job))

    def _attempt(self, job):
        try:
            return job(self.mouse)
        except MouseAsleep:
            self.mouse.close()
            return {"state": "asleep"}
        except NoPermission as e:
            return {"state": "no-permission", "error": str(e)}
        except NoReceiver as e:
            return {"state": "no-receiver", "error": str(e)}
        except RazerError as e:
            self.mouse.close()
            return {"state": "error", "error": str(e)}


class DockWatcher(QObject):
    """Listens for dock/undock reports and USB plugging, so the tray reacts without waiting for a poll."""

    changed = pyqtSignal()
    relinked = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.udev = self._udev_monitor()
        self.known_links = set(find_links())
        threading.Thread(target=self._watch, daemon=True).start()

    @staticmethod
    def _udev_monitor():
        try:
            import pyudev
        except ImportError:
            return None  # plugging is then noticed by the 30 s rescan below
        monitor = pyudev.Monitor.from_netlink(pyudev.Context())
        monitor.filter_by("hidraw")
        monitor.start()
        return monitor

    def _plugged(self):
        """Drain udev events; True if the set of Razer receivers and cables changed."""
        while self.udev.poll(timeout=0) is not None:
            pass
        links = set(find_links())
        changed, self.known_links = links != self.known_links, links
        return changed

    def _watch(self):
        fds = {}
        while True:
            if not fds:
                for path, _ in find_links(EVENT_INTERFACE):
                    try:
                        fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                    except OSError:
                        pass
                if not fds and not self.udev:
                    time.sleep(10)  # receiver unplugged or no permission yet
                    continue
            watched = list(fds) + ([self.udev] if self.udev else [])
            ready, _, _ = select.select(watched, [], [], 30)
            plugged = self.udev in ready and self._plugged()
            rescan = fds and not ready and {p for p, _ in find_links(EVENT_INTERFACE)} != set(fds.values())
            if plugged or rescan:
                for stale in fds:
                    os.close(stale)
                fds = {}
                self.relinked.emit()
                continue
            for fd in ready:
                if fd is self.udev:
                    continue
                try:
                    report = os.read(fd, 64)
                except BlockingIOError:
                    continue
                except OSError:
                    # Unplugged: drop every node and rescan, since hidraw numbers get reused.
                    for stale in fds:
                        os.close(stale)
                    fds = {}
                    break
                if len(report) > 1 and report[0] == EVENT_REPORT_ID and report[1] in DOCK_EVENTS:
                    self.changed.emit()


def optional(read):
    try:
        return read()
    except RazerError:
        return None


def read_status(mouse):
    if mouse.fd is None:
        mouse.connect()
    raw = mouse.battery_raw()
    # Only the battery is essential; a failed extra read must not throw it away.
    return {"state": "ok", "raw": raw, "charging": optional(mouse.charging),
            "idle": optional(mouse.idle_time), "lighting": optional(mouse.lighting_on), "link": mouse.link}


class Tray:
    def __init__(self, app):
        self.app = app
        self.level = None
        self.charging = False
        self.link = None
        self.idle = None
        self.last_read = None
        self.warned = set()
        self.told_full = False
        self.told_permission = False
        self.last_logged = None
        self.raw = None
        self.low_notification = None
        self.session = Session()
        self.settings = load_settings()
        self.ring_sent = None  # (colour, brightness, charging) last written to the dock
        self.ring_sent_at = 0
        self.previewing = False
        self.blinking = False
        self.session.load(HISTORY)

        self.reader = Reader()
        self.reader.finished.connect(self.on_result)

        self.icon = QSystemTrayIcon(render_icon(None, False, True))
        self.icon.setToolTip(f"{APP_NAME}: reading…")
        self.icon.setContextMenu(self.build_menu())
        self.icon.activated.connect(lambda reason: self.refresh() if reason == QSystemTrayIcon.ActivationReason.Trigger else None)
        self.icon.show()

        # The charging state follows the dock report by ~2.5 s, so read now and again after it.
        self.watcher = DockWatcher()
        self.watcher.changed.connect(self.refresh_soon)
        self.watcher.relinked.connect(self.relink)

        self.timer = QTimer()
        self.timer.timeout.connect(self.refresh)
        self.timer.start(POLL_SECONDS * 1000)
        self.refresh()

    def build_menu(self):
        menu = QMenu()
        self.status_action = menu.addAction("Reading…")
        self.status_action.setEnabled(False)
        self.eta_action = menu.addAction("")
        self.eta_action.setEnabled(False)
        self.eta_action.setVisible(False)
        menu.addSeparator()
        menu.addAction("Refresh now", self.refresh)
        lighting_menu = menu.addMenu("Lighting")
        self.lighting_group = QActionGroup(lighting_menu)
        self.lighting_actions = {}
        for on, label in ((True, "On"), (False, "Off")):
            action = QAction(label, lighting_menu, checkable=True)
            action.triggered.connect(lambda _, on=on: self.set_lighting(on))
            self.lighting_group.addAction(action)
            lighting_menu.addAction(action)
            self.lighting_actions[on] = action

        ring_menu = menu.addMenu("Dock ring")
        self.ring_group = QActionGroup(ring_menu)
        self.ring_actions = {}
        for mode, label in (("level", "Charge level"), ("custom", "Custom colour…"), ("off", "Off")):
            action = QAction(label, ring_menu, checkable=True)
            action.setChecked(self.settings.get("dock_ring", "level") == mode)
            if mode == "custom":
                action.triggered.connect(self.pick_colour)
                if "dock_colour" in self.settings:
                    action.setIcon(swatch(self.settings["dock_colour"]))
            else:
                action.triggered.connect(lambda _, mode=mode: self.set_ring_mode(mode))
            self.ring_group.addAction(action)
            ring_menu.addAction(action)
            self.ring_actions[mode] = action
        ring_menu.addSeparator()
        self.brightness_group = QActionGroup(ring_menu)
        for name in RING_BRIGHTNESS:
            action = QAction(f"{name} brightness", ring_menu, checkable=True)
            action.setChecked(self.settings.get("dock_brightness", "Medium") == name)
            action.triggered.connect(lambda _, name=name: self.set_ring_brightness(name))
            self.brightness_group.addAction(action)
            ring_menu.addAction(action)

        idle_menu = menu.addMenu("Sleep when idle for")
        self.idle_group = QActionGroup(idle_menu)
        self.idle_actions = {}
        for seconds in IDLE_CHOICES:
            action = QAction(f"{seconds // 60} min", idle_menu, checkable=True)
            action.triggered.connect(lambda _, s=seconds: self.set_idle(s))
            self.idle_group.addAction(action)
            idle_menu.addAction(action)
            self.idle_actions[seconds] = action

        menu.addSeparator()
        menu.addAction("Quit", self.app.quit)
        self.menu = menu
        return menu

    def refresh(self):
        self.reader.poll()

    def refresh_soon(self):
        for ms in (300, 3500):
            QTimer.singleShot(ms, self.refresh)

    def relink(self):
        """A receiver or cable came or went: drop the current link so the probe order picks again."""
        self.ring_sent = None  # a replugged dock has lost its live colour
        self.reader.run(lambda mouse: mouse.close() or read_status(mouse))
        self.refresh_soon()

    def set_lighting(self, on):
        def job(mouse):
            if mouse.fd is None:
                mouse.connect()
            if not any(mouse.set_lighting(on).values()):
                notify("Lighting unchanged", "The mouse did not accept the change.")
            return read_status(mouse)
        self.reader.run(job)

    def set_ring_mode(self, mode):
        self.settings["dock_ring"] = mode
        save_settings(self.settings)
        self.update_ring()

    def pick_colour(self):
        """Colour dialog that previews on the ring as you drag; Cancel puts the old mode back."""
        start = QColor(*self.settings.get("dock_colour", (0, 160, 255)))
        dialog = QColorDialog(start)
        dialog.setWindowTitle("Dock ring colour")
        self.previewing = True
        self.preview_rgb = None
        preview_timer = QTimer(singleShot=True, interval=80)

        def send_preview():
            rgb = led_colour(self.preview_rgb)
            brightness = RING_BRIGHTNESS.get(self.settings.get("dock_brightness"), RING_BRIGHTNESS["Medium"])
            self.reader.run(lambda mouse: (dock_set_colour(rgb, brightness), {"state": "dock"})[1])

        def changed(colour):
            self.preview_rgb = colour.getRgb()[:3]
            if not preview_timer.isActive():
                preview_timer.start()  # at most one write per 80 ms while dragging

        preview_timer.timeout.connect(send_preview)
        dialog.currentColorChanged.connect(changed)
        accepted = dialog.exec() == QColorDialog.DialogCode.Accepted
        preview_timer.stop()
        self.previewing = False
        self.ring_sent = None  # whatever the preview left on the ring gets rewritten
        if accepted:
            self.settings["dock_colour"] = list(dialog.currentColor().getRgb()[:3])
            self.ring_actions["custom"].setIcon(swatch(self.settings["dock_colour"]))
            self.set_ring_mode("custom")
        else:
            self.ring_actions[self.settings.get("dock_ring", "level")].setChecked(True)
            self.update_ring()

    def set_ring_brightness(self, name):
        self.settings["dock_brightness"] = name
        save_settings(self.settings)
        self.update_ring()

    def update_ring(self):
        if self.previewing or self.blinking:
            return
        mode = self.settings.get("dock_ring", "level")
        brightness = RING_BRIGHTNESS.get(self.settings.get("dock_brightness"), RING_BRIGHTNESS["Medium"])
        if mode == "off":
            wanted = ((0, 0, 0), 0, self.charging, mode)
        elif mode == "custom":
            wanted = (led_colour(self.settings.get("dock_colour", (0, 160, 255))), brightness, self.charging, mode)
        elif self.level is None:
            return
        else:
            charged = self.charging and self.level >= RING_CHARGED_AT
            wanted = (RING_CHARGED if charged else ring_colour(self.level), brightness, self.charging, mode)
        if wanted == self.ring_sent:
            return
        # A colour drift waits its turn; a mode, brightness or charging change goes out at once.
        only_drift = self.ring_sent and self.ring_sent[1:] == wanted[1:] and mode == "level"
        if only_drift and time.time() - self.ring_sent_at < RING_EVERY[self.charging]:
            return
        brightness = None if self.ring_sent and self.ring_sent[1] == wanted[1] else wanted[1]
        self.ring_sent, self.ring_sent_at = wanted, time.time()
        # Through the worker, so dock writes never interleave with the mouse's reads on the same device.
        self.reader.run(lambda mouse: (dock_set_colour(wanted[0], brightness), {"state": "dock"})[1])

    def set_idle(self, seconds):
        def job(mouse):
            mouse.set_idle_time(seconds)
            return read_status(mouse)
        self.reader.run(job)

    def on_result(self, result):
        state = result["state"]
        if state == "dock":
            return
        if state == "ok":
            previous = self.level
            self.raw, self.link = result["raw"], result["link"]
            self.level = pct(self.raw)
            if result["charging"] is not None:
                self.charging = result["charging"]
            self.session.add(time.time(), self.raw, self.link, self.charging)
            interval = (CHARGING_POLL_SECONDS if self.charging else POLL_SECONDS) * 1000
            if self.timer.interval() != interval:
                self.timer.start(interval)
            if result["idle"] is not None:
                self.idle = result["idle"]
            if result["lighting"] is not None:
                self.lighting_actions[result["lighting"]].setChecked(True)
            self.last_read = time.time()
            self.log_reading()
            self.check_notifications(previous)
            self.update_ring()
            for seconds, action in self.idle_actions.items():
                action.setChecked(seconds == self.idle)
        elif state == "no-permission" and not self.told_permission:
            self.told_permission = True
            notify("Can't read the mouse", result["error"], "critical")

        stale = state != "ok"
        self.eta = None if stale else self.session.summary(self.level)
        self.eta_action.setText(self.eta or "")
        self.eta_action.setVisible(bool(self.eta))
        self.icon.setIcon(render_icon(self.level, self.charging and not stale, stale))
        summary = self.describe(state, result.get("error"))
        self.icon.setToolTip(summary)
        self.status_action.setText(summary.splitlines()[0])

    def log_reading(self):
        """Append to the history whenever the raw level or charging changes; battery_stats reads it back."""
        reading = (self.raw, self.charging)
        if reading == self.last_logged:
            return
        self.last_logged = reading
        try:
            os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
            with open(HISTORY, "a") as f:
                f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')},{self.level},{int(self.charging)},{self.link},{self.raw}\n")
        except OSError:
            pass

    def describe(self, state, error):
        if self.level is None:
            known = "Battery unknown"
        else:
            known = f"Battery {self.level}%" + (", charging" if self.charging else "")
        if state == "ok":
            via = SHORT_LINK.get(self.link, self.link)
            line = f"Battery {self.level}%, " + (f"charging via {via}" if self.charging else f"connected to {via}")
            return line + (f"\n{self.eta}" if self.eta else "")
        age = f" (as of {time.strftime('%H:%M', time.localtime(self.last_read))})" if self.last_read else ""
        reason = {"asleep": "Mouse asleep or out of range", "no-receiver": "No dock or dongle found"}.get(state, error)
        return f"{known}{age}\n{reason}"

    def blink_charged(self, seconds=10, interval_ms=500):
        """Flash the ring blue, then hand it back to update_ring, which leaves it solid blue."""
        if self.settings.get("dock_ring", "level") != "level":
            return
        self.blinking = True
        steps = seconds * 1000 // interval_ms
        steps += steps % 2 == 0  # an odd count ends on a lit step, so solid blue follows with no dark gap

        def step(i):
            if i >= steps:
                self.blinking = False
                self.ring_sent = None
                self.update_ring()
                return
            # Frames, not the static effect or brightness: neither of those visibly blinks on this dock.
            rgb = RING_CHARGED if i % 2 == 0 else (0, 0, 0)
            self.reader.run(lambda mouse: (dock_set_frame(rgb), {"state": "dock"})[1])
            QTimer.singleShot(interval_ms, lambda: step(i + 1))
        step(0)

    def check_notifications(self, previous):
        if self.charging:
            self.warned.clear()
            if self.low_notification:
                close_notification(self.low_notification)
                self.low_notification = None
            # Only on seeing it reach 100, so starting the tray with a full mouse stays quiet.
            if self.level >= 100 and previous is not None and previous < 100 and not self.told_full:
                self.told_full = True
                notify("Mouse fully charged", f"Charged via {SHORT_LINK.get(self.link, self.link)}.")
                self.blink_charged()
            return
        self.told_full = False
        crossed = {t for t in WARN_AT if self.level <= t}
        if crossed - self.warned:
            self.warned |= crossed
            # Each warning replaces the last, so charging has only one to dismiss.
            self.low_notification = notify(f"Mouse battery at {self.level}%", "Put it on the dock to charge.",
                                           "critical" if min(crossed) <= 10 else "normal",
                                           replaces=self.low_notification)


def already_running():
    """Holds a lock for the process's lifetime; a second copy (say two autostart entries) exits."""
    import fcntl
    runtime = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
    global _lock
    _lock = open(os.path.join(runtime, "razer-naga-tray.lock"), "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except OSError:
        return True


def main():
    if already_running():
        sys.exit("razer-naga-tray is already running.")
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setDesktopFileName("razer-naga-tray")
    app.setQuitOnLastWindowClosed(False)
    if not QSystemTrayIcon.isSystemTrayAvailable():
        sys.exit("No system tray available.")
    tray = Tray(app)  # noqa: F841 (kept alive for the app's lifetime)
    sys.exit(app.exec())


