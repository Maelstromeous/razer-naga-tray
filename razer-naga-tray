def themed(*names):
    """The first of these the desktop's icon theme has, so the menu matches the rest of the desktop."""
    for name in names:
        if QIcon.hasThemeIcon(name):
            return QIcon.fromTheme(name)
    return QIcon()
SHORT_LINK = {"USB cable": "USB", "Mouse Dock Pro": "dock", "wireless dongle": "dongle"}
HISTORY = os.path.expanduser("~/.local/state/razer-naga-tray/battery.csv")
SETTINGS = os.path.expanduser("~/.config/razer-naga-tray/settings.json")
RING_BRIGHTNESS = {"Low": 64, "Medium": 128, "High": 204}
RING_EVERY = {True: 60, False: 10 * 60}  # seconds between charge-level colour updates, by charging state
RING_CHARGED_AT, RING_CHARGED = 95, (0, 0, 255)  # on a charger and near full: blue, whatever the source
LIGHTS = {
    "dock": ("Dock ring", (("onboard", "Onboard profile"), ("cycle", "Colour cycle"), ("level", "Charge level"),
                           ("custom", "Custom colour…"), ("off", "Off"))),
    "mouse": ("Mouse lighting", (("onboard", "Onboard profile"), ("cycle", "Colour cycle"), ("level", "Charge level"),
                                 ("custom", "Custom colour…"), ("off", "Off"))),
}
